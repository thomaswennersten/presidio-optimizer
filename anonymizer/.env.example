# Kopiera till backend/.env. Tomma Presidio-fält = kör lokalt, vilket är normalfallet.
PRESIDIO_ANALYZER_ENDPOINT=
PRESIDIO_ANALYZER_API_KEY=
PRESIDIO_ANONYMIZER_ENDPOINT=
PRESIDIO_ANONYMIZER_API_KEY=
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=docx,xlsx,pdf,txt
UPLOAD_FOLDER=/tmp/uploads
OUTPUT_FOLDER=/tmp/outputs
